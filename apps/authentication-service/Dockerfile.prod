# -------------------
# Builder Stage
# -------------------
FROM node:22-alpine AS builder

WORKDIR /app/haribon

# Install dependencies
COPY package.json package-lock.json nx.json tsconfig.* ./
RUN npm install

# Copy Prisma schema & generate client (shared lib)
COPY prisma ./prisma/
RUN npx prisma generate

# Copy the workspace files
COPY . .

# Build only this service
RUN npx nx build authentication-service

# -------------------
# Runner Stage
# -------------------
FROM node:22-alpine AS runner

WORKDIR /app/haribon

# Copy only necessary files from builder
COPY --from=builder /app/haribon/dist/apps/authentication-service ./dist/authentication-service
COPY --from=builder /app/haribon/node_modules ./node_modules
COPY --from=builder /app/haribon/package.json ./package.json

ENV NODE_ENV=production
EXPOSE 3001

CMD ["node", "dist/authentication-service/main.js"]
