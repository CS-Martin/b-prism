{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@authentication-mongodb-lib": ["libs/backend/database-services/authentication-mongodb-lib/src/index.ts"],
            "@authentication-service-lib": ["libs/backend/app-services/authentication-service-lib/src/index.ts"],
            "@b-prism/activity-log-mongodb-lib": ["libs/backend/database-services/activity-log-mongodb-lib/src/index.ts"],
            "@b-prism/dispensing-point-mongodb-lib": ["libs/backend/database-services/dispensing-point-mongodb-lib/src/index.ts"],
            "@b-prism/dispensing-point-service-lib": ["libs/backend/app-services/dispensing-point-service-lib/src/index.ts"],
            "@b-prism/enums": ["libs/enums/src/index.ts"],
            "@b-prism/rescue-post-mongodb-lib": ["libs/backend/database-services/rescue-post-mongodb-lib/src/index.ts"],
            "@b-prism/rescue-post-service-lib": ["libs/backend/app-services/rescue-post-service-lib/src/index.ts"],
            "@b-prism/shadcn-lib": ["libs/shadcn-lib/src/index.ts"],
            "@b-prism/shadcn-lib/*": ["libs/shadcn-lib/src/*"],
            "@b-prism/shadcn-ui": ["libs/shadcn-ui/src/components"],
            "@b-prism/shadcn-ui/*": ["libs/shadcn-ui/src/*"],
            "@b-prism/types": ["libs/types/src/index.ts"],
            "@b-prism/user-mongodb-lib": ["libs/backend/database-services/user-mongodb-lib/src/index.ts"],
            "@b-prism/user-service-lib": ["libs/backend/app-services/user-service-lib/src/index.ts"],
            "@b-prism/verification-mongodb-lib": ["libs/backend/database-services/verification-mongodb-lib/src/index.ts"],
            "@b-prism/warehouse-mongodb-lib": ["libs/backend/database-services/warehouse-mongodb-lib/src/index.ts"],
            "@b-prism/warehouse-service-lib": ["libs/backend/app-services/warehouse-service-lib/src/index.ts"],
            "@b-prism/web-app/admin-dashboard-hooks": ["apps/web-app/src/hooks/admin-dashboard.hook.ts"],
            "@b-prisma/activity-log-service-lib": ["libs/backend/app-services/activity-log-service-lib/src/index.ts"],
            "@dto": ["libs/dto/src/index.ts"],
            "@lib-utils": ["libs/utils/src/index.ts"],
            "@map-service-lib": ["libs/backend/app-services/map-service-lib/src/index.ts"],
            "@prisma-db-lib": ["libs/backend/prisma-db-lib/src/index.ts"],
            "@user-service-lib": ["libs/backend/app-services/user-service-lib/src/index.ts"],
            "@verification-service-lib": ["libs/backend/app-services/verification-service-lib/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
