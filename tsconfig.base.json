{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@authentication-mongodb-lib": [
                "libs/backend/database-services/authentication-mongodb-lib/src/index.ts"
            ],
            "@authentication-service-lib": [
                "libs/backend/app-services/authentication-service-lib/src/index.ts"
            ],
            "@dto": ["libs/dto/src/index.ts"],
            "@map-service-lib": [
                "libs/backend/app-services/map-service-lib/src/index.ts"
            ],
            "@prisma-db-lib": ["libs/backend/prisma-db-lib/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
