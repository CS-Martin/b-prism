generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  unverified
  verified
}

model user {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  auth0_id     String?  @default("") @map("auth0_id")
  name         String
  email        String
  office       String
  password     String
  position     String
  id_image_url String?  @default("")
  role         UserRole @default(unverified)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
