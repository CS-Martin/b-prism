generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Type {
  warehouse
  dispensing_point
  evacuation_center
}

enum ActivityLogAction {
  create
  update
  delete
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  provider     String
  given_name   String
  family_name  String
  email        String   @unique
  password     String
  office       String?
  position     String?
  role         String   @default("Default")
  id_image_url String?
  refresh_token String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions String[]
  is_default  Boolean? @default(false)
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Warehouse {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  type              Type     @default(warehouse)
  name              String
  description       String?
  longitude         Float
  latitude          Float
  capacity          Int?
  cost_of_stockpile Int?
  family_food_packs Int?
  standby_funds     Int?
  non_food_items    Json?
  address           Json?
  user_id           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model DispensingPoint {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        Type     @default(dispensing_point)
  name        String
  description String?
  longitude   Float
  latitude    Float
  capacity    Int?
  user_id     String?
  address     Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}


// ========== RESCUE POST ==================

type RescuePostContactPerson {
  name String
  contact String
}

type RescuePostDemographics {
  total_adults Int
  total_children Int
  total_elderly Int
}

type RescuePostLocation {
  address String?
  landmark String?
  longitude Float?
  latitude Float?
}

model RescuePost {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  contact_persons           RescuePostContactPerson[]
  demographics              RescuePostDemographics?
  location                  RescuePostLocation
  number_of_people_affected Int
  isRescued                 Boolean @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
}


// ========= ACTIVITY LOG ==================

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String
  description String
  resource    String
  resource_id String?
  author      String
  timestamp   DateTime @default(now())
}

model Mailer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String
  user_id    String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

// ======== ROAD NETWORK ================

model RoadNetwork {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  type               String
  damage_probability Float
  is_damaged         Boolean
  properties         Json?
  geometry           Json?

  @@index([is_damaged])
}
