generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  unverified
  verified
}

enum Type {
  warehouse
  dispensin_point
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  given_name   String
  family_name  String
  email        String   @unique
  password     String
  office       String?
  position     String?
  role         UserRole @default(unverified)
  id_image_url String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Warehouse {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      Type     @default(warehouse)
  name      String
  longitude String
  latitude  String
  address   Json?
  capacity  Json?
  items     Json[]
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DispensinPoint {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        Type     @default(dispensin_point)
  name        String
  description String?
  longitude   String
  latitude    String
  capacity    Int?
  userId      String?
  details     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RescuePost {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  longitude                 String?
  latitude                  String?
  contact_persons           Json[]
  total_adults              Int
  total_children            Int
  total_elderly             Int
  number_of_people_affected Int
  address                   String?
  landmark                  String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}
