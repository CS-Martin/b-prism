generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  unverified
  verified
}

model user {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  given_name   String
  family_name  String
  email        String   @unique
  password     String
  office       String?
  position     String?
  role         UserRole @default(unverified)
  id_image_url String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
