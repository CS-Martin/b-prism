generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  unverified
  verified
}

enum Type {
  warehouse
  dispensing_point
  evacuation_center
}

enum ActivityLogAction {
  create
  update
  delete
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  given_name   String
  family_name  String
  email        String   @unique
  password     String
  office       String?
  position     String?
  role         UserRole @default(unverified)
  id_image_url String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Warehouse {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  type              Type     @default(warehouse)
  name              String
  description       String?
  longitude         String
  latitude          String
  capacity          Int?
  cost_of_stockpile Int?
  family_food_packs Int?
  standby_funds     Int?
  non_food_items    Json?
  address           Json?
  user_id           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model DispensingPoint {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        Type     @default(dispensing_point)
  name        String
  description String?
  longitude   String
  latitude    String
  capacity    Int?
  user_id     String?
  address     Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model RescuePost {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  longitude                 String?
  latitude                  String?
  contact_persons           Json[]
  total_adults              Int
  total_children            Int
  total_elderly             Int
  number_of_people_affected Int
  address                   String?
  landmark                  String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String
  description String
  user_id     String
  created_at  DateTime @default(now())
}
