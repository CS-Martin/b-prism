generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model user {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  createdAt String
  email     String
  id_       String  @map("id")
  image_url String?
  name      String
  office    String
  password  String
  position  String
  updatedAt String
}
