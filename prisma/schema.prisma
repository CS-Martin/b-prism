generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Type {
  warehouse
  dispensing_point
  evacuation_center
}

enum ActivityLogAction {
  create
  update
  delete
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  provider     String
  given_name   String
  family_name  String
  email        String   @unique
  password     String
  office       String?
  position     String?
  role         String   @default("Default")
  id_image_url String?
  refresh_token String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions String[]
  is_default  Boolean? @default(false)
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Warehouse {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  type              Type     @default(warehouse)
  name              String
  description       String?
  longitude         Float
  latitude          Float
  capacity          Int?
  cost_of_stockpile Int?
  family_food_packs Int?
  standby_funds     Int?
  non_food_items    Json?
  address           Json?
  user_id           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model DispensingPoint {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        Type     @default(dispensing_point)
  name        String
  description String?
  longitude   Float
  latitude    Float
  capacity    Int?
  user_id     String?
  address     Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model RescuePost {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  longitude                 String?
  latitude                  String?
  contact_persons           Json[]
  total_adults              Int
  total_children            Int
  total_elderly             Int
  number_of_people_affected Int
  address                   String?
  landmark                  String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String // CREATE, UPDATE, DELETE, etc.
  description String // Description of the activity
  resource    String // Name of the resource (e.g., "User", "Warehouse")
  resource_id String? // ID of the resource affected (nullable for non-resource actions like login/logout)
  author      String // ID of the user who performed the action
  timestamp   DateTime @default(now()) // Timestamp of when the activity occurred
}

model Mailer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String
  user_id    String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model RoadNetwork {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  type               String
  damage_probability Float
  is_damaged         Boolean
  properties         Json?
  geometry           Json?

  @@index([is_damaged])
}
